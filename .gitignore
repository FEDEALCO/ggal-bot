# Secretos reales - NUNCA subir esto a un repo (ver .env.example).
.env
.env.*
!.env.example

# Estado/telemetria local (no son "codigo", y ademas revelan operativa real).
logs/
state/
data_cache/

# Artefactos de build (PyInstaller) y de Python.
build/
dist/
*.spec
__pycache__/
*.pyc
.pytest_cache/

# Entornos virtuales / IDE.
venv/
.venv/
.vscode/
.idea/

# Cache local pesado, no hace falta para correr el bot en el contenedor.
instruments_sample.json

# Secretos/tokens sueltos, movidos ahi para no commitearlos nunca (ver
# limpieza del 2026-09-04 - mover a un gestor de contraseñas cuando puedas).
_tokens_no_subir/

# Log gigante de 24hs (no es codigo, y pesa cientos de MB - no pertenece al repo).
ultimas24hs.log

# Datos de operaciones reales - no pertenece al repo.
Operaciones/

# Bundle temporal usado para restaurar el historial de git.
*.bundle
*.patch
