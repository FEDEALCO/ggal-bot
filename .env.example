# Copiar este archivo a ".env" y completar con las credenciales reales del ALYC.
# NUNCA subir el archivo ".env" real a un repositorio o compartirlo.

# --- Credenciales de PyRofex / API del ALYC ---------------------------------
PYROFEX_USER=
PYROFEX_PASSWORD=
PYROFEX_ACCOUNT=

# REMARKET = ambiente de paper trading (usar siempre primero aca)
# LIVE     = ambiente real, opera con dinero real
PYROFEX_ENV=REMARKET

# Endpoints propios del ALYC (opcional). Muchos brokers argentinos corren su
# propia instancia de la API Matriz/Primary sobre la que trabaja pyRofex; si
# tu ALYC te dio una URL de REST y otra de WebSocket, completalas aca. Si se
# dejan vacias, pyRofex usa el default de la libreria para el ambiente elegido.
PYROFEX_REST_URL=
PYROFEX_WS_URL=

# Reconexion automatica de websocket (ver order_gateway.WebSocketConnectionManager)
PYROFEX_WS_RECONNECT_INITIAL_SECONDS=2
PYROFEX_WS_RECONNECT_MAX_SECONDS=60
PYROFEX_WS_RECONNECT_BACKOFF_FACTOR=2
PYROFEX_WS_MAX_RECONNECT_ATTEMPTS=0

# --- Credenciales de SOLO Market Data (MD-only), para la fuente Shadow
# "primary_ws" (ver ggal_bot/data/live_shadow_feed.py:PrimaryMarketDataSource
# y README, seccion "Evaluacion de fuentes de datos alternativas") ----------
# Si tu ALYC te da un usuario de solo lectura de market data (recomendado
# para esto: no permite operar, solo consultar puntas), completalo aca en vez
# de reusar las credenciales de trading real de arriba. Si se dejan vacias,
# "primary_ws" cae a PYROFEX_USER/PASSWORD/ACCOUNT/ENV de arriba.
PYROFEX_MD_USER=
PYROFEX_MD_PASSWORD=
PYROFEX_MD_ACCOUNT=
PYROFEX_MD_ENV=

# --- Parametros cuantitativos por defecto -----------------------------------
# Tasa libre de riesgo local (ARS) anualizada, en decimal (0.40 = 40%)
GGAL_BOT_RISK_FREE_RATE=0.40
GGAL_BOT_DIVIDEND_YIELD=0.0

# Umbral de delta-neutralidad: acciones equivalentes de GGAL antes de rehedgear
GGAL_BOT_DELTA_NEUTRAL_THRESHOLD=150

# Slippage maximo tolerado en ordenes (fraccion, 0.01 = 1%)
GGAL_BOT_MAX_SLIPPAGE_PCT=0.01
# Movimiento del subyacente que fuerza cancelar/repricear una orden pendiente
GGAL_BOT_UNDERLYING_MOVE_CANCEL_PCT=0.005

# Guardia de staleness de datos de mercado (ver run_bot.py:_is_market_data_stale):
# si pasan mas de este umbral (segundos) sin una actualizacion exitosa del
# spot de GGAL (caida de conectividad con data912/websocket, timeouts
# repetidos), el bot deja de generar ENTRADAS nuevas y de completar spreads
# hasta que vuelva a haber datos frescos. Las SALIDAS (Stop Loss/Take
# Profit/etc.) y el delta-hedger siguen evaluandose con la ultima punta
# conocida - deliberado, ver README. Agregado tras un caso real de caida
# sostenida de data912.com (10+ minutos de timeouts consecutivos).
GGAL_BOT_MAX_DATA_STALENESS_SECONDS=60

# --- Shadow Trading / Live Replay (ver ggal_bot/data/live_shadow_feed.py) ---
# Activar cuando el ambiente REMARKET del ALYC no tenga aprovisionada la
# cadena de opciones de GGAL (ver diagnose_instruments.py). En este modo:
#   - Los datos de mercado vienen de data912.com (REST publico, sin
#     autenticacion) o, si no responde, de un generador Mock/Replay local.
#   - order_gateway.py NUNCA envia ordenes reales: simula el fill al mid
#     vigente y lo audita en logs/shadow_trades.csv.
GGAL_BOT_SHADOW_MODE=false

# "auto" (default, LEGADO) = intenta data912.com y cae a "mock" si no
# responde; "data912" fuerza el REST publico; "mock" fuerza el generador
# sintetico (100% local, sin red). Se mantiene por compatibilidad - para
# elegir entre MAS de dos fuentes con prioridad explicita (ej. Primary via
# pyRofex antes que data912), usar GGAL_BOT_SHADOW_SOURCE_PRIORITY abajo, que
# tiene prioridad sobre esta variable si esta seteada.
GGAL_BOT_SHADOW_SOURCE=auto

# --- Multi-fuente con prioridad y failover automatico (ver
# ggal_bot/config.py ShadowConfig.source_priority() y README, seccion
# "Evaluacion de fuentes de datos alternativas") -----------------------------
# Lista de nombres de fuente separados por coma, EN ORDEN DE PREFERENCIA.
# Si esta vacia (default), se usa el selector legado de arriba
# (GGAL_BOT_SHADOW_SOURCE). Nombres validos:
#   primary_ws   -> Primary/Matba Rofex via pyRofex, MD-only (requiere
#                   pyRofex instalado + PYROFEX_MD_USER/PASSWORD/ACCOUNT o
#                   PYROFEX_USER/PASSWORD/ACCOUNT arriba). La fuente mas
#                   solida tecnicamente (L1 real, oficial, ya integrada al
#                   proyecto via market_data_feed.py/order_gateway.py).
#   data912      -> REST publico data912.com (sin autenticacion).
#   broker_rest  -> scaffold de un ALYC local (ej. IOL) - NO VERIFICADO
#                   contra una cuenta real (ver docstring de BrokerRestSource
#                   en live_shadow_feed.py). NO agregar aca sin haber
#                   validado antes el endpoint/esquema real contra tu cuenta.
#   mock         -> generador sintetico 100% local (siempre disponible,
#                   incluirlo al final es la red de seguridad recomendada).
# Ejemplo (una vez que tengas credenciales MD-only de tu ALYC):
#   GGAL_BOT_SHADOW_SOURCE_PRIORITY=primary_ws,data912,mock
GGAL_BOT_SHADOW_SOURCE_PRIORITY=

# Cuantos polls fallidos CONSECUTIVOS (sin datos utiles) tolera la fuente
# activa antes de conmutar automaticamente a la siguiente de la prioridad -
# deliberadamente > 1 para no reaccionar a un timeout aislado.
GGAL_BOT_SHADOW_SOURCE_FAILURE_THRESHOLD=3

# Cada cuanto se reintenta volver a una fuente de MAYOR prioridad tras un
# failover previo (segundos). Evita "flapping" si la fuente preferida esta
# intermitente en vez de caida del todo.
GGAL_BOT_SHADOW_SOURCE_REPROBE_SECONDS=300

# Cada cuantos segundos se refresca la cadena de opciones en modo shadow
# (equivalente al "tick" de mercado; no confundir con el ciclo de calculo
# de run_bot.py, que puede ser mas frecuente que el propio dato).
GGAL_BOT_SHADOW_POLL_SECONDS=5

# Base URL de la fuente REST publica (dejar por defecto salvo que se quiera
# apuntar a un espejo/proxy propio).
GGAL_BOT_DATA912_BASE_URL=https://data912.com
GGAL_BOT_SHADOW_REQUEST_TIMEOUT=5

# --- Fuente REST de IOL/InvertirOnline (ver
# ggal_bot/data/live_shadow_feed.py:BrokerRestSource) --------------------
# Login y esquema de cotizacion/opciones CONFIRMADOS corriendo
# "python diagnose_iol_api.py" contra una cuenta real (ver README, seccion
# "IOL / InvertirOnline"). Completar usuario/contraseña de tu cuenta de IOL
# y correr ese script una vez para confirmarlo tambien en tu caso (el
# mercado/segmento de version pueden variar) ANTES de agregar "broker_rest"
# a GGAL_BOT_SHADOW_SOURCE_PRIORITY. Sin usuario Y contraseña completos,
# esta fuente se declara no disponible de inmediato (nunca intenta loguearse).
BROKER_REST_USERNAME=
BROKER_REST_PASSWORD=
BROKER_REST_BASE_URL=https://api.invertironline.com
# Compartido por /Cotizacion (liviana) y /Opciones (masiva: 174 registros
# con cotizacion embebida en cada uno). 5s alcanza fuera de horario pero
# puede quedarse corto en horario de mercado activo (Read timed out en los
# logs). 15s confirmado como margen razonable contra una cuenta real.
BROKER_REST_REQUEST_TIMEOUT=15

# Segmento de mercado esperado por la URL de cotizacion/opciones (ej.
# "/api/v2/{market}/Titulos/{simbolo}/Cotizacion"). "bCBA" confirmado contra
# una cuenta real para instrumentos de GGAL/BYMA.
BROKER_REST_MARKET=bCBA
# Segmento de version de la URL. "v2" confirmado contra una cuenta real; se
# deja configurable (poner vacio para omitirlo) por si IOL lo cambia.
BROKER_REST_API_VERSION_SEGMENT=v2

# Parametros del generador Mock/Replay (solo aplican si se usa esa fuente;
# ver ggal_bot/config.py ShadowConfig para la lista completa de parametros
# ajustables, incluida la semilla aleatoria GGAL_BOT_MOCK_SEED).
GGAL_BOT_MOCK_INITIAL_SPOT=6600.0
GGAL_BOT_MOCK_ATM_IV=0.55
GGAL_BOT_MOCK_SEED=0

# --- Selector de estrategia activa para run_bot.py (ver ggal_bot/config.py
# StrategyConfig) ---
# Valores validos:
#   weekly_asymmetric -> Long-First / Weekly Asymmetric (DEFAULT, ver seccion
#                        siguiente y strategy/weekly_asymmetric.py)
#   vol_arbitrage     -> arbitraje de volatilidad delta-neutral original
#                        (ver strategy/vol_arbitrage.py)
# Un valor invalido (ej. typo) NO frena el arranque: run_bot.py cae a
# "weekly_asymmetric" y loguea una advertencia explicita.
GGAL_BOT_ACTIVE_STRATEGY=weekly_asymmetric

# --- Modo "Long-First / Weekly Asymmetric" (ver ggal_bot/config.py LongFirstConfig,
# strategy/weekly_asymmetric.py, risk/position_sizer.py) ---
# Sin posiciones descubiertas (el ALYC no permite venta en descubierto de
# calls/puts), horizonte de tenencia maximo semanal, sizing dinamico por
# capital asignado. Modo operativo DISTINTO del arbitraje delta-neutral
# original (parametros GGAL_BOT_DELTA_NEUTRAL_THRESHOLD y afines, arriba);
# ninguno de los dos se desactiva al usar el otro.
GGAL_BOT_LONG_FIRST_MODE=true

# Capital maximo asignado a este modo, y % maximo de ese capital que se
# arriesga por trade/estructura (0.20 = 20%).
GGAL_BOT_MAX_CAPITAL_ARS=1000000
GGAL_BOT_MAX_RISK_PCT_PER_TRADE=0.20
GGAL_BOT_MIN_CONTRACTS_PER_TRADE=1

# Objetivo de retorno semanal - PARAMETRO DE DIMENSIONAMIENTO, NO una
# proyeccion ni garantia (ver nota de riesgo en ggal_bot/config.py):
# alcanzarlo de forma sostenida requeriria una tasa de acierto y una
# volatilidad de mercado que el bot no puede garantizar ni predecir.
GGAL_BOT_WEEKLY_TARGET_ARS=1000000

# Horizonte maximo de tenencia (ruedas habiles) y guardia de fin de semana
# (fuerza el cierre los viernes si la posicion sigue abierta y el
# vencimiento es posterior, para no sostener theta negativo sin poder
# reaccionar durante el fin de semana).
GGAL_BOT_MAX_HOLDING_BUSINESS_DAYS=5
GGAL_BOT_WEEKEND_THETA_GUARD=true

# Stop Loss / Take Profit, medidos sobre la PRIMA pagada (no sobre el
# subyacente): -50% de la prima cierra en perdida, +100% cierra en ganancia.
GGAL_BOT_STOP_LOSS_PCT=0.50
GGAL_BOT_TAKE_PROFIT_PCT=1.00

# Filtro de entrada: dislocacion minima de smile para considerar "barata"
# una base, banda de moneyness (|log(strike/spot)| maximo) para priorizar
# convexidad ATM/OTM cercana, y si se exige ademas confirmacion de nivel
# (IV promedio del vencimiento tambien por debajo de la HV de referencia).
GGAL_BOT_LONGFIRST_SMILE_THRESHOLD=3.0
GGAL_BOT_MONEYNESS_BAND_PCT=0.15
GGAL_BOT_REQUIRE_LEVEL_CONFIRMATION=false
GGAL_BOT_LONGFIRST_LEVEL_THRESHOLD=5.0

# Spreads (Bull Call / Bear Put): la pata corta solo se contempla si la
# pata larga ya esta confirmada en el portafolio (ver
# strategy/weekly_asymmetric.py). spread_wing_moneyness_pct = separacion
# minima (fraccion del strike largo) para elegir el ala corta.
GGAL_BOT_ENABLE_SPREAD_COMPLETION=true
GGAL_BOT_SPREAD_WING_MONEYNESS_PCT=0.05

# --- Modulo de Analisis Tecnico 1D (ver ggal_bot/config.py TechnicalAnalysisConfig,
# data/technical_analysis.py) ---
# Filtro direccional OBLIGADO para el modo weekly_asymmetric: antes de
# evaluar compra de opciones o armado de spreads, el bot clasifica la
# tendencia principal de GGAL en el grafico DIARIO (1D) como BULLISH/
# BEARISH/NEUTRAL (EMA20/EMA50 + ADX(14) + MACD(12,26,9)) y solo opera en
# la direccion consistente con esa lectura (BULLISH -> solo Calls, BEARISH
# -> solo Puts, NEUTRAL -> exige dislocacion "extrema" para entrar y nunca
# completa spreads). En False, el comportamiento es identico al de antes de
# este modulo (sin filtro direccional alguno).
GGAL_BOT_TECHNICAL_FILTER_ENABLED=true

# "auto" (default) = intenta velas diarias reales de data912.com y cae a un
# generador sintetico local (GBM) si no responde o trae pocas barras;
# "data912" fuerza el REST publico (sin fallback sintetico); "synthetic"
# fuerza el generador local (100% offline, util para tests/demo sin red).
GGAL_BOT_TA_SOURCE=auto

# Velas 1D a pedir (100-200 tipico) y minimo utilizable para animarse a
# clasificar tendencia (por debajo de esto, siempre NEUTRAL con motivo
# explicito "datos insuficientes" - nunca BULLISH/BEARISH por defecto).
GGAL_BOT_TA_LOOKBACK_BARS=200
GGAL_BOT_TA_MIN_BARS=60

# Cada cuanto se refresca el historico diario y se recalculan los
# indicadores (las velas 1D no cambian intra-dia: no tiene sentido pegarle
# a la red en cada ciclo de ~2s del bot). 3600 = 1 hora.
GGAL_BOT_TA_REFRESH_SECONDS=3600

# Periodos de los indicadores (EMA rapida/lenta, RSI, ADX, MACD rapida/lenta/señal).
GGAL_BOT_TA_EMA_FAST=20
GGAL_BOT_TA_EMA_SLOW=50
GGAL_BOT_TA_RSI_PERIOD=14
GGAL_BOT_TA_ADX_PERIOD=14
GGAL_BOT_TA_MACD_FAST=12
GGAL_BOT_TA_MACD_SLOW=26
GGAL_BOT_TA_MACD_SIGNAL=9

# Umbral de ADX para considerar que hay "fuerza de tendencia" (por debajo,
# NEUTRAL aunque EMA20/EMA50 y MACD esten alineados - estructura sin momentum).
GGAL_BOT_TA_ADX_THRESHOLD=20.0

# Bajo NEUTRAL, multiplicador aplicado a GGAL_BOT_LONGFIRST_SMILE_THRESHOLD
# para exigir una dislocacion de smile "extrema" antes de entrar (2.0 = el
# doble del umbral normal). NEUTRAL nunca completa spreads, sin excepcion.
GGAL_BOT_TA_NEUTRAL_EXTREME_MULT=2.0

# --- Momentum Shift / Early Reversal Override ---
# El filtro BULLISH/BEARISH de arriba (EMA20/EMA50/ADX/MACD) es, por
# construccion, un filtro de ESTRUCTURA ya confirmada: siempre llega DESPUES
# de que el nuevo regimen ya arranco (recien cruzan las medias moviles luego
# de varias ruedas en la nueva direccion). Para no perder movimientos por
# operar demasiado tarde, sin eliminar el filtro de tendencia en si (sigue
# siendo obligatorio), esta señal complementaria basada en RSI(14) (lider,
# acotado 0-100, evita el problema de escala que tendria comparar puntos de
# histograma MACD sobre el precio nominal de GGAL, que viene re-preciandose
# fuerte por depreciacion del ARS) detecta una reversion temprana: si el RSI
# se movio GGAL_BOT_TA_MOMENTUM_RSI_DELTA puntos o mas EN CONTRA de la
# tendencia vigente en las ultimas GGAL_BOT_TA_MOMENTUM_LOOKBACK_BARS velas,
# el tipo de opcion contrario deja de descartarse de plano en las ENTRADAS
# nuevas (scan_entry_signals) - pero solo se admite bajo el umbral EXTREMO de
# dislocacion de smile (el mismo de arriba, GGAL_BOT_TA_NEUTRAL_EXTREME_MULT),
# nunca el normal. No afecta el armado de spreads (scan_spread_completion_signals),
# que se mantiene estrictamente alineado a la tendencia vigente.
GGAL_BOT_TA_ENABLE_MOMENTUM_OVERRIDE=true
GGAL_BOT_TA_MOMENTUM_LOOKBACK_BARS=3
GGAL_BOT_TA_MOMENTUM_RSI_DELTA=8.0

# --- Confirmacion de microestructura (ver ggal_bot/models/microstructure.py,
# Order Book Imbalance) ---
# Filtro de CALIDAD DE EJECUCION, no de alpha direccional: descarta una base
# barata si el libro muestra un desbalance extremo hacia el lado vendedor
# (ask_size >> bid_size), tipico de una punta aislada/iliquida en un libro
# tan delgado como el de opciones de GGAL. min_obi_for_entry=-0.30 solo
# bloquea el 30% mas desbalanceado hacia el lado vendedor.
GGAL_BOT_ENABLE_OBI_FILTER=true
GGAL_BOT_MIN_OBI_FOR_ENTRY=-0.30

# --- Salida por compresion de Vega (ver risk/risk_manager.py evaluate_vega_decay_exit) ---
# Complementa (no reemplaza) Stop Loss/Take Profit/horizonte semanal: si el
# |vega| actual de una posicion cayo por debajo de este porcentaje del
# |vega| que tenia al momento de la entrada, la tesis de convexidad que
# motivo la compra ya se agoto y se cierra, aunque el PnL% de la prima
# todavia no dispare ninguna otra regla.
GGAL_BOT_ENABLE_VEGA_DECAY_EXIT=true
GGAL_BOT_VEGA_DECAY_EXIT_RATIO=0.35

# =============================================================================
# Modo "Scalping Intradia y Trading Semanal de Corto Plazo" (ADITIVO - ver
# ggal_bot/config.py:ScalpingConfig, ggal_bot/strategy/scalping.py)
# =============================================================================
# DECISION DE ARQUITECTURA (leer antes de tocar esto): este modo NO es un
# valor mas de GGAL_BOT_ACTIVE_STRATEGY. Es un modulo BOLT-ON, completamente
# independiente, que corre SIEMPRE DESPUES del ciclo de la estrategia
# principal (weekly_asymmetric o vol_arbitrage) en el MISMO proceso del bot,
# con su propio capital, sus propias posiciones (marcadas internamente) y sus
# propias reglas de entrada/salida. Gateado por su propio flag
# (GGAL_BOT_ENABLE_SCALPING, default false): con el flag en false (o sin
# setear), NADA de lo que sigue tiene ningun efecto - el bot se comporta
# exactamente igual que sin este modulo, y la gestion de una posicion ya
# abierta bajo weekly_asymmetric (Stop Loss/Take Profit/horizonte semanal/
# guardia de fin de semana) no se ve afectada de ninguna forma.
GGAL_BOT_ENABLE_SCALPING=false

# --- Capital y sizing dinamico (pool SEPARADO del de weekly_asymmetric -
# GGAL_BOT_MAX_CAPITAL_ARS de arriba) ---
GGAL_BOT_SCALPING_MAX_CAPITAL_ARS=1000000.0
GGAL_BOT_SCALPING_MAX_RISK_PCT_PER_TRADE=0.08
GGAL_BOT_SCALPING_MIN_CONTRACTS_PER_TRADE=1
GGAL_BOT_SCALPING_MAX_CONCURRENT_POSITIONS=6

# --- Filtro de entrada (mismo espiritu que GGAL_BOT_LONGFIRST_SMILE_THRESHOLD/
# GGAL_BOT_MONEYNESS_BAND_PCT de arriba, pero reutilizados via un
# ScalpingConfig separado con umbrales propios) ---
GGAL_BOT_SCALPING_SMILE_THRESHOLD=2.0
GGAL_BOT_SCALPING_MONEYNESS_BAND_PCT=0.10
# Horizonte de ELEGIBILIDAD de entrada (dias habiles al vencimiento) - NO
# confundir con GGAL_BOT_SCALPING_MAX_HOLDING_MINUTES abajo (horizonte de
# SALIDA de una posicion ya abierta, en minutos).
GGAL_BOT_SCALPING_MAX_HOLDING_BUSINESS_DAYS=3
GGAL_BOT_SCALPING_REQUIRE_LEVEL_CONFIRMATION=false
GGAL_BOT_SCALPING_LEVEL_THRESHOLD=5.0
GGAL_BOT_SCALPING_ENABLE_OBI_FILTER=true
GGAL_BOT_SCALPING_MIN_OBI_FOR_ENTRY=-0.15

# --- Profundidad minima de punta vendedora (ver
# ggal_bot/models/microstructure.py.passes_min_ask_depth) - "garantizar fill
# inmediato", mas estricto que el OBI de arriba (que solo mira el desbalance
# RELATIVO, no el tamaño ABSOLUTO de la punta) ---
GGAL_BOT_SCALPING_ENABLE_MIN_ASK_DEPTH_FILTER=true
GGAL_BOT_SCALPING_MIN_ASK_SIZE=30.0

# --- Salida forzada sobre la PRIMA (ver
# ggal_bot/risk/risk_manager.py:evaluate_scalping_exit) - umbrales mas
# ajustados que weekly_asymmetric (GGAL_BOT_STOP_LOSS_PCT/
# GGAL_BOT_TAKE_PROFIT_PCT de arriba) ---
GGAL_BOT_SCALPING_STOP_LOSS_PCT=0.25
GGAL_BOT_SCALPING_TAKE_PROFIT_PCT=0.35

# --- Horizonte ACELERADO de salida, en MINUTOS (la diferencia central
# respecto de weekly_asymmetric, que usa dias habiles) ---
GGAL_BOT_SCALPING_MAX_HOLDING_MINUTES=120.0
# Cierre preventivo por FALTA DE PROGRESO: si a los N minutos de abierta la
# posicion todavia no alcanzo el % de ganancia minimo sobre la prima, se
# cierra - "moverse rapido o salir".
GGAL_BOT_SCALPING_PROGRESS_CHECK_MINUTES=30.0
GGAL_BOT_SCALPING_MIN_PROGRESS_PNL_PCT=0.05

# --- Cierre obligatorio de Fin de Dia (EOD), en horario de Argentina (ART =
# UTC-3 todo el año, sin horario de verano desde 2009) - nunca se sostiene
# una posicion de scalping durante la noche/fin de semana ---
GGAL_BOT_SCALPING_EOD_CLOSE_ENABLED=true
GGAL_BOT_SCALPING_EOD_CLOSE_TIME=16:50
GGAL_BOT_SCALPING_EOD_TZ_OFFSET_HOURS=-3.0

# --- Reversion de IV en alta frecuencia (ver
# ggal_bot/data/iv_mean_reversion.py) - salida ADICIONAL para cuando la
# dislocacion de smile que motivo la entrada ya se corrigio hacia el
# comportamiento reciente de esa base en particular (z-score de la propia
# serie de dislocaciones, no un umbral fijo en vol points) ---
GGAL_BOT_SCALPING_ENABLE_IV_REVERSION_EXIT=true
GGAL_BOT_SCALPING_IV_REVERSION_WINDOW_SECONDS=1800.0
GGAL_BOT_SCALPING_IV_REVERSION_MIN_SAMPLES=10
GGAL_BOT_SCALPING_IV_REVERSION_EXIT_ZSCORE=0.5

# --- Analisis Tecnico intradia MULTI-TIMEFRAME (ver
# ggal_bot/data/intraday_bars.py - reusa compute_technical_snapshot() de
# data/technical_analysis.py sin forkearlo). Dos timeframes (rapido/lento)
# en vez del unico grafico 1D; periodos de indicador mas cortos/rapidos,
# calibrados para velas de minutos en vez de diarias.
# GGAL_BOT_SCALPING_REQUIRE_MTF_AGREEMENT exige que AMBOS timeframes
# coincidan antes de habilitar una direccion (si no, NEUTRAL). ---
GGAL_BOT_SCALPING_FAST_BAR_MINUTES=5
GGAL_BOT_SCALPING_SLOW_BAR_MINUTES=15
GGAL_BOT_SCALPING_REQUIRE_MTF_AGREEMENT=true
GGAL_BOT_SCALPING_MAX_BARS_RETAINED=300
GGAL_BOT_SCALPING_TA_REFRESH_SECONDS=30.0
GGAL_BOT_SCALPING_TA_MIN_BARS=25
GGAL_BOT_SCALPING_TA_EMA_FAST=9
GGAL_BOT_SCALPING_TA_EMA_SLOW=21
GGAL_BOT_SCALPING_TA_RSI_PERIOD=9
GGAL_BOT_SCALPING_TA_ADX_PERIOD=9
GGAL_BOT_SCALPING_TA_MACD_FAST=6
GGAL_BOT_SCALPING_TA_MACD_SLOW=13
GGAL_BOT_SCALPING_TA_MACD_SIGNAL=5
GGAL_BOT_SCALPING_TA_ADX_THRESHOLD=15.0
GGAL_BOT_SCALPING_TA_ENABLE_MOMENTUM_OVERRIDE=false
GGAL_BOT_SCALPING_TA_MOMENTUM_LOOKBACK_BARS=3
GGAL_BOT_SCALPING_TA_MOMENTUM_RSI_DELTA=10.0
