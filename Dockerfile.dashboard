# Dockerfile.dashboard para correr el Dashboard de monitoreo (dashboard/app.py)
# como servicio APARTE en Northflank (o cualquier host con Docker).
#
# Notas de diseño:
# - Imagen SEPARADA del Dockerfile del bot (Dockerfile): ese instala solo
#   requirements.txt (pyRofex/python-dotenv/requests) a proposito, sin
#   Streamlit/Plotly/pandas (ver comentario ahi). Esta imagen instala
#   ADEMAS requirements-dashboard.txt.
# - El dashboard (dashboard/app.py, ver ggal_bot.paths) lee
#   logs/shadow_trades.csv y state/bot_state.json de forma RELATIVA a la
#   raiz del proyecto (WORKDIR /app en ambas imagenes) - para que muestre
#   las operaciones REALES del bot que corre en el servicio del Dockerfile
#   original, este servicio necesita el MISMO volumen persistente de
#   Northflank montado en las mismas rutas (/app/logs, /app/state,
#   /app/data_cache) - ver Northflank > Volumes, y montarlo en AMBOS
#   servicios (bot y dashboard). Sin eso, este servicio arranca igual pero
#   muestra el estado vacio ("Todavia no hay operaciones registradas...").
# - No requiere NINGUN cambio en dashboard/app.py ni en paths.py: ambos ya
#   resuelven todo relativo a PROJECT_ROOT, que en un contenedor Docker
#   coincide con WORKDIR.
# - Puerto: Streamlit necesita bindear a 0.0.0.0 y al puerto que Northflank
#   le asigne. Northflank inyecta $PORT en runtime; si no esta seteada (ej.
#   build/test local), se usa 8501 (el default de Streamlit) como fallback.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt requirements-dashboard.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dashboard.txt

COPY ggal_bot/ ggal_bot/
COPY dashboard/ dashboard/

# Mismas rutas candidatas a volumen persistente que declara Dockerfile (ver
# ese archivo): se crean aca tambien para que el healthcheck/primer arranque
# de Streamlit no falle si el volumen todavia no esta montado.
RUN mkdir -p logs state data_cache

EXPOSE 8501

# Shell form (no exec/array form) a proposito: hace falta expansion de
# variable de entorno ($PORT) al arrancar, que el array form de CMD no hace.
CMD streamlit run dashboard/app.py \
    --server.port ${PORT:-8501} \
    --server.address 0.0.0.0 \
    --server.headless true \
    --server.enableCORS false \
    --server.enableXsrfProtection false
